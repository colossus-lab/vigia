# Caddy reverse proxy para producción (EC2 + Docker Compose).
# TLS automático contra Let's Encrypt.
#
# Montado por docker-compose.prod.yml:
#   caddy:
#     image: caddy:2
#     ports: ["80:80", "443:443"]
#     volumes:
#       - ./infra/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
#       - caddy_data:/data

vigia-api.openarg.org {
	# Security headers (la API solo se sirve por HTTPS detrás de Caddy).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No filtrar el stack del upstream.
		-Server
	}
	# OJO: apuntar al NOMBRE DE CONTENEDOR, no al de servicio. Licitar corre en
	# el mismo EC2 y se une a `vigia_default` con un servicio también llamado
	# `api` (ver ../Licitar/docker-compose.prod.yml), así que el DNS de Docker
	# resuelve `api` a DOS IPs y hace round-robin: ~50% de las requests de Vigía
	# las contestaba la API de Licitar (404 en /normas, /stats, /search, /avisos).
	reverse_proxy vigia-api-1:8000
	encode gzip
}

# Licitar (proyecto hermano, repo privado) comparte este EC2 y este Caddy: su
# compose se une a `vigia_default` y no levanta proxy propio. El bloque vive acá
# —y no suelto en el servidor— porque un `git pull` en el EC2 lo borraba y
# dejaba licitar-api.openarg.org sin ruteo, en silencio, en cada deploy.
# El dominio ya es público de todos modos: Let's Encrypt publica cada
# certificado en los logs de Certificate Transparency.
licitar-api.openarg.org {
	reverse_proxy licitar-api-1:8000
}
